rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: true only when the person is logged in
    function signedIn() {
      return request.auth != null;
    }

    // users: each person can only read and write their own profile
    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // lessons: any logged-in user can read, nobody can write from the app
    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // progress: a user can only see and change their own progress
    match /progress/{progressId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // notes: a user can only see and change their own notes
    match /notes/{noteId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }
  }
}